    "total_hadiths": 270
  },
  {
    "chapter_id": 3,
    "chapter_number": 3,
    "chapter_urdu": "اذان اور نماز كا بیان",
    "chapter_english": "",
    "total_hadiths": 315
  },
  {
    "chapter_id": 4,
    "chapter_number": 4,
    "chapter_urdu": "قربانی، ذبحہ ، عقیقہ،كھانے،پینے\nاور حیوانوں كےساتھ نرمی كرنے كا بیان",
    "chapter_english": "",
    "total_hadiths": 129
  },
  {
    "chapter_id": 5,
    "chapter_number": 5,
    "chapter_urdu": "ایمان، توحید، دین اورتقدیر كا بیان",

    "total_hadiths": 256
  },
  {
    "chapter_id": 6,
    "chapter_number": 6,
    "chapter_urdu": "قسم، نذراور کفاروں کا بیان",
    "chapter_english": "",
    "total_hadiths": 14
  },
  {
